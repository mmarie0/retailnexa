# Copy to .env.local for local development. NEVER commit real values.
# In Vercel, set these under Project → Settings → Environment Variables.

# Public site URL (used for auth email links and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Used solely by: Stripe webhook/sync, cron, lead intake.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers → API keys (use test keys until launch)
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://<domain>/api/webhooks/stripe → Signing secret
STRIPE_WEBHOOK_SECRET=
# Products → recurring monthly Price IDs
STRIPE_PRICE_RETAIL=
STRIPE_PRICE_RETAIL_EXTRA_LOCATION=
STRIPE_PRICE_WHOLESALE=

# Random 32+ char string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
